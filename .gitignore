node_modules/
dist/
.env
*.log
*.tsbuildinfo
.env.*
*.key
*.pem
src-tauri/target/
.cargo-target/
# Generated on Linux; equivalent to the existing desktop schema.
/src-tauri/gen/schemas/linux-schema.json
data/*
!data/README.md

# Evidencia local, borradores de agentes y documentos personales: nunca publicar.
/.openchamber/
/scratch/
/artifacts/
/scripts/testing/.fixtures/
docs/*.docx

# Avatares privados: se cargan localmente y no se redistribuyen con Alice.
Assets/*.vrm
Assets/*.vroid

# Clips corporales privados o sujetos a licencias de terceros.
Assets/Animations/private/

# Modelos locales de visión: se verifican por SHA-256 y no se redistribuyen.
Assets/Models/private/
# Prototipos externos en cuarentena: no forman parte del runtime ni del repositorio.
/adapters/
/.venv-adapters/
__pycache__/

# Recursos privados y resultados locales; sólo se publican las guías.
/local/*
!/local/README.md
!/local/assets/
/local/assets/**
!/local/assets/Animations/
!/local/assets/Animations/README.md
!/local/assets/Models/
!/local/assets/Models/README.md
