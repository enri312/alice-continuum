{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alice Continuum",
  "version": "0.1.0",
  "identifier": "com.carlosnunez.alicecognitivecore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "E:\\Alice Cognitive Core\\Assets\\Alice.vrm",
          "E:\\Alice Cognitive Core\\Assets\\Animations\\private\\mixamo\\**"
        ]
      }
    },
    "windows": [
      {
        "title": "Alice Continuum — Memoria, cognición y presencia",
        "width": 1000,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
