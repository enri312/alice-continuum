{
  "name": "alice-continuum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["Frontend"],
  "scripts": {
    "dev": "npm run dev --workspace=Frontend --",
    "dioxus:build": "node scripts/dioxus/build-state-controls.mjs",
    "dioxus:check": "node scripts/dioxus/build-state-controls.mjs --check",
    "icons:generate": "node scripts/icons/generate-icons.mjs",
    "build": "npm run build --workspace=Frontend",
    "test": "vitest run --config Frontend/vite.config.ts --root . && npm run test:obsidian && npm run test:backup && npm run test:privacy",
    "test:privacy": "node --test scripts/testing/repository-privacy.node.test.ts",
    "test:dioxus:browser": "node scripts/testing/dioxus-browser-smoke.mjs",
    "test:dioxus:native": "node scripts/testing/dioxus-native-smoke.mjs",
    "test:obsidian": "node --test scripts/obsidian/*.test.mjs",
    "test:backup": "node --test scripts/backups/*.test.mjs",
    "eval:r8:report": "node scripts/testing/r8-report.mjs",
    "backup": "node scripts/backups/cli.mjs",
    "obsidian:sync": "node scripts/obsidian/sync.mjs",
    "obsidian:sync:python": "node scripts/obsidian/sync.mjs --formatter python",
    "obsidian:watch": "node scripts/obsidian/sync.mjs --watch",
    "test:watch": "vitest --config Frontend/vite.config.ts --root .",
    "preview": "npm run preview --workspace=Frontend --",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0"
  }
}
