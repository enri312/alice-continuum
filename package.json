{
  "name": "alice-continuum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons:generate": "node scripts/icons/generate-icons.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run && npm run test:obsidian && npm run test:backup",
    "test:obsidian": "node --test scripts/obsidian/sync.test.mjs",
    "test:backup": "node --test scripts/backups/*.test.mjs",
    "backup": "node scripts/backups/cli.mjs",
    "obsidian:sync": "node scripts/obsidian/sync.mjs",
    "obsidian:watch": "node scripts/obsidian/sync.mjs --watch",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0"
  }
}
